{
  "printWidth": 140,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "none",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-organize-attributes"],
  "attributeGroups": ["$DEFAULT", "^(id|name)$", "^class$", "^data-.+$", "^aria-.+$", "$ANGULAR_TEMPLATE"],
  "attributeSort": "ASC"
}
